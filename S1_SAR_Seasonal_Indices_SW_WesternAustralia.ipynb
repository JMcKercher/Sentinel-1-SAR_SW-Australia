        "           [116.22429333713164,-34.43729474707892]]])\n",
        "aoi = ee.Feature(geom)\n",
        "\n",
        "# Or....  Access the Walpole Wilderness Area from my GGE assets\n",
        "ww_aoi = ee.FeatureCollection('projects/ee-jmckercher/assets/Walpole_Wilderness')"
      ],
